{
  "name": "@lp181818/dsh-vision-plugin",
  "description": "DSH vision/image-recognition plugin: enables AI to understand images with a configurable vision model",
  "version": "1.0.3",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "sync": "node sync.mjs",
    "prepublishOnly": "node build.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "vision",
    "image",
    "llm"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/schemastery": "*",
    "react": "^18.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bug-huntter/dsh-vision-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/bug-huntter/dsh-vision-plugin/issues"
  },
  "homepage": "https://github.com/bug-huntter/dsh-vision-plugin#readme",
  "author": "bug-huntter",
  "funding": "https://github.com/sponsors/bug-huntter"
}
